{
  "name": "bookai",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "db:generate": "turbo db:generate",
    "db:push": "turbo db:push",
    "db:seed": "turbo db:seed",
    "test": "cd packages/ai && npx vitest run",
    "test:watch": "cd packages/ai && npx vitest",
    "clean": "turbo clean && rm -rf node_modules"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "turbo": "^2.4.0",
    "typescript": "^5.7.0",
    "vitest": "^4.1.4"
  },
  "packageManager": "npm@10.8.0",
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3"
  }
}
